# YatraGuard AI — environment
#
# Copy to .env.local and fill in. Every service below has a genuinely free tier
# that does not need a credit card (Section 3 of PROJECT_MASTER_PROMPT.md).
# If any signup unexpectedly asks for a card, stop and flag it — there is a free
# alternative for all of these.
#
# Check what is wired up at any time: GET /api/status

# ---------------------------------------------------------------------------
# MongoDB Atlas — free M0 cluster, no card
# https://cloud.mongodb.com → Create → M0 → Connect → Drivers
# Remember to allow network access from 0.0.0.0/0 for Vercel.
# ---------------------------------------------------------------------------
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="yatraguard"

# ---------------------------------------------------------------------------
# Google Gemini — free tier via Google AI Studio, no card
# https://aistudio.google.com/app/apikey
# Powers bill OCR (8.1), scam classification (8.2) and menu OCR (8.4).
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"

# ---------------------------------------------------------------------------
# OpenRouteService — free API key, no card
# https://openrouteservice.org/dev/#/signup
# Powers directions and landmark search (8.3). Map tiles come from
# OpenStreetMap and need no key at all.
# ---------------------------------------------------------------------------
OPENROUTESERVICE_API_KEY=""

# ---------------------------------------------------------------------------
# Firebase Authentication — Spark (free) plan, no card
# https://console.firebase.google.com → Authentication → Google + Email link
#
# Client keys: Project settings → Your apps → Web app config.
# These are public by design; they identify the project, they do not grant access.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Admin credentials: Project settings → Service accounts → Generate new private key.
# NEVER commit these. Keep the private key's \n escapes exactly as they appear
# in the downloaded JSON, wrapped in double quotes.
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Demo sign-in (optional)
#
# Lets a judge or teammate open the app without a Firebase account. Off unless
# BOTH flags are "true". Guest accounts are real rows in the database but cannot
# be signed back into. Leave this off for any deployment that matters.
# ---------------------------------------------------------------------------
ALLOW_GUEST_LOGIN="false"
NEXT_PUBLIC_ALLOW_GUEST_LOGIN="false"

# Required only when ALLOW_GUEST_LOGIN is true — signs guest session cookies.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
